# ===== Supabase Configuration =====

# 1) Supabase Dashboard -> Connect -> Postgres -> Session pooler connection string
#    (port 6543, sslmode=require, NO channel_binding)
DATABASE_URL=postgresql://postgres.[PROJECT]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require

# 2) Supabase Dashboard -> Project Settings -> API
#    (used for admin login on the client AND for verifying admin tokens in /api)
VITE_SUPABASE_URL=https://[PROJECT-ID].supabase.co
VITE_SUPABASE_ANON_KEY=[ANON-PUBLIC-KEY]
